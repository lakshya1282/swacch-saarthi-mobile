# API Configuration
# Update this IP address if your local network IP changes
# Get your current IP with: ipconfig (Windows) or ifconfig (Mac/Linux)
API_HOST=10.10.119.150
API_PORT=3001

# Socket.IO Configuration
SOCKET_HOST=10.10.119.150
SOCKET_PORT=3001

# Environment
NODE_ENV=development
# Allow demo credentials to work even when DB is connected (development only)
ALLOW_DEMO_LOGIN=true

# AI Services Configuration for Waste Validation
# Using TensorFlow.js as primary (no billing required)
# Switch to google_vision after enabling billing in Google Cloud Console
REACT_APP_DEFAULT_AI_SERVICE=tensorflow

# Google Vision API (Free: 1,000 requests/month)
# Get API key from: https://console.cloud.google.com/apis/credentials
# API key configured and ready to use
REACT_APP_GOOGLE_VISION_API_KEY=AIzaSyBtEEXgvModOkBdt6ME06nOEAvHz3W5no0

# Fallback: TensorFlow.js (completely free, runs locally)
# Will be used automatically if Google Vision API fails or reaches limits

# Optional: Add other free AI services when needed
# Hugging Face API (Free: 30,000 requests/month)
# Get your free API token from: https://huggingface.co/settings/tokens
# REACT_APP_HUGGINGFACE_TOKEN=your_huggingface_token_here

# Roboflow API (Free: 1,000 requests/month)
# Sign up at: https://roboflow.com/
# REACT_APP_ROBOFLOW_API_KEY=your_roboflow_api_key_here
# REACT_APP_ROBOFLOW_MODEL_URL=https://detect.roboflow.com/your-model/version
